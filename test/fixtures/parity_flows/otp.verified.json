{
  "id": "otp.verified",
  "title": "otp-node (real): email sent (POST otp/send), code verified (POST otp/verify) -> saves the email and <var>_verified=true, leaves by source",
  "covers": [
    "otp-node"
  ],
  "provenance": "executed",
  "source": "QA bot \"QA - All Nodes\"",
  "server": {
    "http": {
      "otp/send": {
        "status": 200,
        "body": {
          "sent": true,
          "sentTo": "a***@acme.io",
          "resendIn": 30
        }
      },
      "otp/verify": {
        "status": 200,
        "body": {
          "verified": true,
          "email": "ana@acme.io"
        }
      }
    }
  },
  "flow": {
    "nodes": [
      {
        "id": "w",
        "type": "welcome-node",
        "data": {
          "text": "<p>Hi</p>",
          "disableImage": true
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "otp",
        "type": "otp-node",
        "data": {
          "questionText": "<p>Let's confirm your email first.</p>",
          "channel": "email",
          "emailSource": "ask",
          "emailVariable": "",
          "emailSubject": "Your Acme Cloud code",
          "maxAttempts": 3,
          "allowSkip": false,
          "skipLabel": "Skip",
          "answerVariable": "work_email"
        },
        "position": {
          "x": 440,
          "y": 120
        }
      },
      {
        "id": "otpOk",
        "type": "message-node",
        "data": {
          "text": "<p>Verified: {work_email} ({work_email_verified}).</p>"
        },
        "position": {
          "x": 800,
          "y": 120
        }
      },
      {
        "id": "otpFail",
        "type": "message-node",
        "data": {
          "text": "<p>Not verified ({work_email_verified}).</p>"
        },
        "position": {
          "x": 1160,
          "y": 120
        }
      }
    ],
    "edges": [
      {
        "id": "e-w-source-otp",
        "source": "w",
        "sourceHandle": "source",
        "target": "otp",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      },
      {
        "id": "e-otp-source-otpOk",
        "source": "otp",
        "sourceHandle": "source",
        "target": "otpOk",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      },
      {
        "id": "e-otp-source-failed-otpFail",
        "source": "otp",
        "sourceHandle": "source-failed",
        "target": "otpFail",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      }
    ]
  },
  "inputs": [
    {
      "at": "otp",
      "do": "otpEmail",
      "email": "Ana@Acme.io"
    },
    {
      "at": "otp",
      "do": "otpCode",
      "code": "123456"
    }
  ],
  "expect": {
    "path": [
      {
        "node": "w",
        "type": "welcome-node",
        "via": "start",
        "t": 0
      },
      {
        "node": "otp",
        "type": "otp-node",
        "via": "edge:source",
        "t": 700
      },
      {
        "node": "otpOk",
        "type": "message-node",
        "via": "port:source",
        "t": 1566
      }
    ],
    "shown": [
      {
        "node": "w",
        "t": 700
      },
      {
        "node": "otp",
        "t": 1486
      },
      {
        "node": "otpOk",
        "t": 2630
      }
    ],
    "drawn": [
      {
        "node": "w",
        "text": "Hi"
      },
      {
        "node": "otp",
        "text": "Let's confirm your email first. Email verified a***@acme.io"
      },
      {
        "node": "otpOk",
        "text": "Verified: ana@acme.io (true)."
      }
    ],
    "rendered": [
      {
        "node": "w",
        "html": "<p>Hi</p>",
        "plain": "Hi"
      },
      {
        "node": "otp",
        "html": "<p>Let's confirm your email first.</p>",
        "plain": "Let's confirm your email first."
      },
      {
        "node": "otpOk",
        "html": "<p>Verified: ana@acme.io (true).</p>",
        "plain": "Verified: ana@acme.io (true)."
      }
    ],
    "ports": [
      {
        "node": "otp",
        "handle": "source",
        "wired": true
      }
    ],
    "transcript": [
      {
        "by": "bot",
        "message": "<p>Hi</p>"
      },
      {
        "by": "bot",
        "message": "<p>Let's confirm your email first.</p>"
      },
      {
        "by": "user",
        "message": "Verified: ana@acme.io"
      },
      {
        "by": "bot",
        "message": "<p>Verified: {work_email} ({work_email_verified}).</p>"
      }
    ],
    "answers": [
      {
        "id": "otp",
        "shape": "user-otp",
        "verified": true,
        "email": "ana@acme.io",
        "channel": "email"
      }
    ],
    "variables": [
      {
        "key": "work_email",
        "value": "ana@acme.io",
        "nodeId": "otp"
      },
      {
        "key": "work_email_verified",
        "value": true,
        "nodeId": "column_mapped_work_email_verified"
      }
    ],
    "errors": [],
    "http": [
      {
        "path": "otp/send",
        "body": {
          "nodeId": "otp",
          "sessionId": "qa-session",
          "email": "ana@acme.io"
        }
      },
      {
        "path": "otp/verify",
        "body": {
          "nodeId": "otp",
          "sessionId": "qa-session",
          "code": "123456"
        }
      }
    ],
    "emits": [
      "chat-flow-completed"
