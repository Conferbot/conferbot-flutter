{
  "id": "otp.wrong-code-then-locked",
  "title": "otp-node: a wrong code says how many tries are left; \"locked\" ends the step on source-failed with <var>_verified=false",
  "covers": [
    "otp-node"
  ],
  "provenance": "executed",
  "source": "QA bot \"QA - All Nodes\"",
  "server": {
    "http": {
      "otp/send": {
        "status": 200,
        "body": {
          "sent": true
        }
      },
      "otp/verify": [
        {
          "status": 400,
          "body": {
            "code": "wrong_code",
            "attemptsLeft": 2
          }
        },
        {
          "status": 423,
          "body": {
            "code": "locked"
          }
        }
      ]
    }
  },
  "flow": {
    "nodes": [
      {
        "id": "w",
        "type": "welcome-node",
        "data": {
          "text": "<p>Hi</p>",
          "disableImage": true
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "otp",
        "type": "otp-node",
        "data": {
          "questionText": "<p>Let's confirm your email first.</p>",
          "channel": "email",
          "emailSource": "ask",
          "emailVariable": "",
          "emailSubject": "Your Acme Cloud code",
          "maxAttempts": 3,
          "allowSkip": false,
          "skipLabel": "Skip",
          "answerVariable": "work_email"
        },
        "position": {
          "x": 440,
          "y": 120
        }
      },
      {
        "id": "otpOk",
        "type": "message-node",
        "data": {
          "text": "<p>Verified: {work_email} ({work_email_verified}).</p>"
        },
        "position": {
          "x": 800,
          "y": 120
        }
      },
      {
        "id": "otpFail",
        "type": "message-node",
        "data": {
          "text": "<p>Not verified ({work_email_verified}).</p>"
        },
        "position": {
          "x": 1160,
          "y": 120
        }
      }
    ],
    "edges": [
      {
        "id": "e-w-source-otp",
        "source": "w",
        "sourceHandle": "source",
        "target": "otp",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      },
      {
        "id": "e-otp-source-otpOk",
        "source": "otp",
        "sourceHandle": "source",
        "target": "otpOk",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      },
      {
        "id": "e-otp-source-failed-otpFail",
        "source": "otp",
        "sourceHandle": "source-failed",
        "target": "otpFail",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      }
    ]
  },
  "inputs": [
    {
      "at": "otp",
      "do": "otpEmail",
      "email": "ana@acme.io"
    },
    {
      "at": "otp",
      "do": "otpCode",
      "code": "111111"
    },
    {
      "at": "otp",
      "do": "otpCode",
      "code": "222222"
    }
  ],
  "expect": {
    "path": [
      {
        "node": "w",
        "type": "welcome-node",
        "via": "start",
        "t": 0
      },
      {
        "node": "otp",
        "type": "otp-node",
        "via": "edge:source",
        "t": 700
      },
      {
        "node": "otpFail",
        "type": "message-node",
        "via": "port:source-failed",
        "t": 1566
      }
    ],
    "shown": [
      {
        "node": "w",
        "t": 700
      },
      {
        "node": "otp",
        "t": 1486
      },
      {
        "node": "otpFail",
        "t": 2510
      }
    ],
    "drawn": [
      {
        "node": "w",
        "text": "Hi"
      },
      {
        "node": "otp",
        "text": "Let's confirm your email first. Not verified Too many wrong codes"
      },
      {
        "node": "otpFail",
        "text": "Not verified (false)."
      }
    ],
    "rendered": [
      {
        "node": "w",
        "html": "<p>Hi</p>",
        "plain": "Hi"
      },
      {
        "node": "otp",
        "html": "<p>Let's confirm your email first.</p>",
        "plain": "Let's confirm your email first."
      },
      {
        "node": "otpFail",
        "html": "<p>Not verified (false).</p>",
        "plain": "Not verified (false)."
      }
    ],
    "ports": [
      {
        "node": "otp",
        "handle": "source-failed",
        "wired": true
      }
    ],
    "transcript": [
      {
        "by": "bot",
        "message": "<p>Hi</p>"
      },
      {
        "by": "bot",
        "message": "<p>Let's confirm your email first.</p>"
      },
      {
        "by": "user",
        "message": "Not verified"
      },
      {
        "by": "bot",
        "message": "<p>Not verified ({work_email_verified}).</p>"
      }
    ],
    "answers": [
      {
        "id": "otp",
        "shape": "user-otp",
        "verified": false,
        "channel": "email",
        "reason": "locked"
      }
    ],
    "variables": [
      {
        "key": "work_email",
        "value": null,
        "nodeId": "otp"
      },
      {
        "key": "work_email_verified",
        "value": false,
        "nodeId": "column_mapped_work_email_verified"
      }
    ],
    "errors": [
      {
        "node": "otp",
        "message": "That code isn't right."
      }
    ],
    "http": [
      {
        "path": "otp/send",
        "body": {
          "nodeId": "otp",
          "sessionId": "qa-session",
          "email": "ana@acme.io"
        }
      },
      {
        "path": "otp/verify",
        "body": {
          "nodeId": "otp",
          "sessionId": "qa-session",
          "code": "111111"
        }
      },
      {
        "path": "otp/verify",
        "body": {
          "nodeId": "otp",
          "sessionId": "qa-session",
          "code": "222222"
        }
      }
    ],
    "emits": [
      "chat-flow-completed"
    ],
    "unsupported": [],
    "end": {
      "ended": true,
      "t": 2510
    }
  }
}
