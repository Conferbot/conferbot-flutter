{
  "id": "subflow.run-and-return",
  "title": "run-subflow-node sets the inputs, jumps to the subflow-node; at the end of that path the outputs are copied back and the flow continues from Run sub-flow's \"source\" edge",
  "covers": [
    "run-subflow-node",
    "subflow-node",
    "subflow-return-node"
  ],
  "provenance": "executed",
  "flow": {
    "nodes": [
      {
        "id": "w",
        "type": "welcome-node",
        "data": {
          "text": "<p>Hi</p>",
          "disableImage": true
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "run",
        "type": "run-subflow-node",
        "data": {
          "subflowId": "sf",
          "inputs": [
            {
              "name": "who",
              "value": "Ana"
            }
          ],
          "outputs": [
            {
              "name": "greeting",
              "variable": "result"
            }
          ]
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "back",
        "type": "message-node",
        "data": {
          "text": "<p>Back: {result}</p>"
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "sf",
        "type": "subflow-node",
        "data": {
          "name": "Greet"
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "set",
        "type": "variable-node",
        "data": {
          "name": "greeting",
          "value": "Hello {who}",
          "isNumber": false
        },
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "ret",
        "type": "subflow-return-node",
        "data": {},
        "position": {
          "x": 0,
          "y": 0
        }
      },
      {
        "id": "never",
        "type": "message-node",
        "data": {
          "text": "<p>never</p>"
        },
        "position": {
          "x": 0,
          "y": 0
        }
      }
    ],
    "edges": [
      {
        "id": "e-w-source-run",
        "source": "w",
        "sourceHandle": "source",
        "target": "run",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      },
      {
        "id": "e-run-source-back",
        "source": "run",
        "sourceHandle": "source",
        "target": "back",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      },
      {
        "id": "e-sf-source-set",
        "source": "sf",
        "sourceHandle": "source",
        "target": "set",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      },
      {
        "id": "e-set-source-ret",
        "source": "set",
        "sourceHandle": "source",
        "target": "ret",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      },
      {
        "id": "e-ret-source-never",
        "source": "ret",
        "sourceHandle": "source",
        "target": "never",
        "targetHandle": "target",
        "type": "customedge",
        "animated": true
      }
    ]
  },
